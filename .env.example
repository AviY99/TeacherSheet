# Google Document AI
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-ocr-processor-id
# On Google Cloud, prefer Application Default Credentials.
# On other hosting providers, provide a service-account JSON object as one line:
GOOGLE_SERVICE_ACCOUNT_JSON=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Used later when packaging the hosted web app with Capacitor
CAPACITOR_SERVER_URL=
