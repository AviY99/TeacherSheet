# Google Document AI
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-ocr-processor-id

# Authentication option A (preferred on Google Cloud): Application Default Credentials.
# Authentication option B (other server hosts): service-account JSON as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Authentication option C: the same service-account JSON encoded as base64.
# If both JSON variables are set, BASE64 takes precedence.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# OpenAI — keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Used later when packaging the hosted web app with Capacitor
CAPACITOR_SERVER_URL=
